# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/career_coach
CHECKPOINT_DB_PATH=postgresql://user:password@localhost:5432/career_coach_checkpoints

# Redis
REDIS_URL=redis://localhost:6379/0

# Adzuna API Configuration
# Get your API credentials at https://developer.adzuna.com/
ADZUNA_APP_ID=your_app_id_here
ADZUNA_APP_KEY=your_app_key_here

# Optional: Set default country for job search (us, gb, ca, au, etc.)
# ADZUNA_COUNTRY=us

# LangSmith — observability, tracing, and RAG evaluation
# Sign up at https://smith.langchain.com to get an API key
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT="your_project_name_here"
